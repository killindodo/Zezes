<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/neon_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="@color/neon_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/neon_cyan">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:id="@+id/ivAppLogo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_app_logo"
                        android:contentDescription="@string/app_name"
                        android:layout_marginEnd="12dp"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_cyan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:letterSpacing="0.2"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivGithub"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_github"
                    android:layout_centerVertical="true"
                    android:contentDescription="GitHub"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true"
                    app:tint="@color/neon_cyan"/>
            </RelativeLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_grey"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/header_subtitle"
                android:letterSpacing="0.1"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThemeSelection"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/neon_cyan"
                app:strokeWidth="1.5dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_cyan"
                        android:id="@+id/tvThemeHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/theme_selection"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/themeSelectorLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/neon_cyan"
                        app:hintTextColor="@color/neon_cyan"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                        <AutoCompleteTextView
                            android:textColor="@color/white"
                            android:id="@+id/themeSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_select_theme"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIsoSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/neon_cyan"
                app:strokeWidth="1.5dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:textColor="@color/neon_cyan"
                        android:id="@+id/pickIsoButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_choose_iso"
                        app:strokeColor="@color/neon_cyan"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:id="@+id/tvIsoFileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/iso_file_name"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:id="@+id/tvIsoFileSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/iso_file_size"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:id="@+id/tvIsoOsType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/iso_os_type"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUsbTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/neon_magenta"
                app:strokeWidth="1.5dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:textColor="@color/neon_magenta"
                        android:id="@+id/scanUsbButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_select_usb"
                        app:strokeColor="@color/neon_magenta"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/deviceSelectorLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxStrokeColor="@color/neon_magenta"
                        app:hintTextColor="@color/neon_magenta"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                        <AutoCompleteTextView
                            android:textColor="@color/white"
                            android:id="@+id/deviceSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/target_device"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:id="@+id/tvUsbDriveName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/usb_drive_name"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:id="@+id/tvUsbCapacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/usb_total_capacity"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:id="@+id/tvUsbFsFormat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/usb_fs_format"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="8dp"
                app:strokeColor="@color/neon_purple"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_purple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/terminal_console"/>
                    <com.example.zezes.SpeedGraphView
                        android:id="@+id/speedGraphView"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#ff0000"
                        android:layout_gravity="end"
                        android:id="@+id/tvSignature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-20dp"
                        android:text="@string/signature"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/neon_green"
                        android:ellipsize="end"
                        android:id="@+id/tvConsoleLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/system_ready"
                        android:maxLines="2"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/neon_purple"
                        android:id="@+id/tvActivityStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/waiting_placeholder"
                        android:fontFamily="monospace"
                        android:textAlignment="center"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/neon_cyan"
                        android:id="@+id/progressDetailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/progress_default"
                        android:textAlignment="center"/>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbFlashingProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:indicatorColor="@color/neon_cyan"
                        app:trackColor="#333333"
                        app:trackThickness="6dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <Button
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/flashButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="@string/btn_initialize_engine"
                app:backgroundTint="@color/neon_cyan"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button"/>
            <Button
                android:id="@+id/extractButton"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
